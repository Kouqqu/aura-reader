<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!-- Active Book Content -->
    <LinearLayout
        android:id="@+id/widget_book_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="visible">

        <!-- Book Cover -->
        <ImageView
            android:id="@+id/widget_book_cover"
            android:layout_width="48dp"
            android:layout_height="68dp"
            android:scaleType="centerCrop"
            android:background="@drawable/widget_cover_placeholder"
            android:contentDescription="Book Cover" />

        <!-- Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_app_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AURA READER"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/widget_accent"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/widget_book_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Название книги"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_title"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_book_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Автор"
                android:textSize="11sp"
                android:textColor="@color/widget_subtitle"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Progress row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/widget_progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress_bar" />

                <TextView
                    android:id="@+id/widget_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="0%"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_accent" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/widget_empty_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Aura Reader" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aura Reader"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_title" />

            <TextView
                android:id="@+id/widget_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Откройте книгу, чтобы продолжить чтение"
                android:textSize="11sp"
                android:textColor="@color/widget_subtitle" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
